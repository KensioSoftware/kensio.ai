# Copy to .env and fill in. .env is gitignored, this file is not.

# Pangram REST API key, used only by opt-in checks that are run by hand. Never
# read by the release workflow or by npm run check. The pangram-check skill will
# find it here as its last resort, and ~/.config/pangram/.env is the better home
# for it, reachable from every repository on the machine.
# https://docs.pangram.com/quickstart-rest
PANGRAM_API_KEY=
