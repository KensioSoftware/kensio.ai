{
  "name": "kensio.ai",
  "version": "1.18.1",
  "private": true,
  "description": "Agent skills from Kensio Software, distributed as zips, npm packages and a Claude Code plugin marketplace.",
  "homepage": "https://kensio.ai",
  "license": "Apache-2.0",
  "author": "Kensio Software <hugh@kensiosoftware.co.uk>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KensioSoftware/kensio.ai.git"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "validate:skills": "node scripts/validate-skills.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "bundle": "node scripts/bundle-skills.mjs",
    "zips": "node scripts/build-zips.mjs",
    "bootstrap:npm": "node scripts/bootstrap-npm.mjs",
    "prose": "node plugins/technical-prose-style/skills/technical-prose-style/scripts/prose-check.mjs plugins packages/skills-cli/README.md README.md",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "npm run format:check && npm run validate:skills && npm run validate && npm run check:versions && npm run prose"
  },
  "devDependencies": {
    "@semantic-release/exec": "^7.1.0",
    "oxfmt": "^0.65.0",
    "semantic-release": "^25.0.9"
  },
  "engines": {
    "node": ">=22.14"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
