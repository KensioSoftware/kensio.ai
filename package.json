{
  "name": "kensio.ai",
  "version": "1.1.0",
  "private": true,
  "description": "Claude Code skills from Kensio Software, distributed as a plugin marketplace and as npm packages.",
  "homepage": "https://kensio.ai",
  "license": "Apache-2.0",
  "author": "Kensio Software <hugh@kensiosoftware.co.uk>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KensioSoftware/kensio.ai.git"
  },
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "npm run format:check && npm run validate && npm run check:versions"
  },
  "devDependencies": {
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "oxfmt": "^0.63.0",
    "semantic-release": "^25.0.9"
  },
  "engines": {
    "node": ">=22.14"
  }
}
